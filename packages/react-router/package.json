{
  "name": "@zeroko-io/react-router",
  "version": "0.1.0",
  "description": "React Router's framework mode on Zeroko: the app built into a Zeroko service and deployed.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@zeroko-io/core": "^0.1.0"
  },
  "peerDependencies": {
    "@react-router/dev": ">=7",
    "react-router": ">=7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "react-router": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeroko-io/sdk.git",
    "directory": "packages/react-router"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
