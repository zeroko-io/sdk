{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".zeroko/**", "build/**", ".output/**", ".svelte-kit/**"],
      "env": ["ZEROKO_URL", "ZEROKO_TOKEN", "ZEROKO_SERVICE"]
    },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
