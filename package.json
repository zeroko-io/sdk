{
  "name": "zeroko-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:e2e": "turbo run build --filter=./packages/* && node test/e2e.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5",
    "turbo": "^2"
  },
  "packageManager": "npm@11.19.1"
}
